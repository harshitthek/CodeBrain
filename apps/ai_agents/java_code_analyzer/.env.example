# LLM Configuration Example
# Copy this file to .env and fill in your configuration

# ============================================
# DeepSeek (Default Recommended)
# ============================================
# Reasoning model (for complex analysis, similar to OpenAI o1)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-reasoner
# OPENAI_MODEL=deepseek-chat

# Or use chat model (faster, suited for simpler tasks)
# OPENAI_MODEL=deepseek-chat

# ============================================
# OpenAI Official
# ============================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# No need to set OPENAI_BASE_URL (defaults to official endpoint)

# ============================================
# Qwen (Aliyun DashScope)
# ============================================
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ============================================
# Zhipu AI (GLM)
# ============================================
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4

# ============================================
# Moonshot (Kimi)
# ============================================
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-32k

# ============================================
# Ollama Local Deployment
# ============================================
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:32b
# Or use: llama3.1:70b, deepseek-coder:33b

# ============================================
# Azure OpenAI
# ============================================
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com
# OPENAI_MODEL=gpt-4
# AZURE_OPENAI_API_VERSION=2023-05-15
