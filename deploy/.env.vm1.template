# ==============================================================================
# CodeBrain Release Guardian - VM 1 Production Environment Configuration
# Target: Oracle Linux 9 (OCI Always Free E2.1.Micro / 1.0 GB RAM)
# ==============================================================================

# 1. Django Core Configuration
DJANGO_SECRET_KEY=generate-a-secure-random-string-here
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,guardian.yourdomain.com
CODEBRAIN_KNOWLEDGE_ENABLED=false

# 2. Fetch.ai / Agentverse ACP Runtime
# FETCH_AGENT_SEED is your uAgent's cryptographic identity secret. Never commit this.
FETCH_AGENT_SEED=replace-with-your-private-seed-phrase
FETCH_AGENT_PORT=8000
FETCH_AGENT_LOCAL_ENDPOINT=

# 3. ASI:One LLM Intelligence
ASI1_API_KEY=replace-with-your-asi-one-api-key
ASI1_MODEL=asi1-mini
ASI1_REQUEST_TIMEOUT=60
RELEASE_GUARDIAN_LLM_PROVIDER=asi1
RELEASE_GUARDIAN_MIN_SCORE=60

# 4. Agentverse Public Registration (Opt-In)
# Enable once your public HTTPS domain is routing to VM 1 Caddy
AGENTVERSE_V2_REGISTRATION_ENABLED=false
AGENTVERSE_API_KEY=
AGENTVERSE_PUBLIC_ENDPOINT=https://guardian.yourdomain.com/submit
AGENTVERSE_LISTENER_WAIT_SECONDS=10

# 5. Local Safe Pytest Verification Boundary
RELEASE_GUARDIAN_ALLOWED_TARGETS=configured_repository
RELEASE_GUARDIAN_REPO_PATH=/home/opc/CodeBrain
RELEASE_GUARDIAN_REPO_TEST_COMMAND=python -m pytest -q
RELEASE_GUARDIAN_REPO_TEST_TIMEOUT=120
