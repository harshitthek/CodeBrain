# Django: use a long random value in every deployed environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Enable these only after the deployed domain serves HTTPS end to end.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# Fetch.ai Release Guardian. The seed is an identity secret, never a chat input.
FETCH_AGENT_SEED=replace-with-a-private-agent-seed
# Local uAgents listener. A public reverse proxy must route its HTTPS `/submit`
# endpoint to this port for optional Agentverse v2 registration.
FETCH_AGENT_PORT=8000
ASI1_API_KEY=replace-with-your-asi-one-api-key
ASI1_MODEL=asi1-mini
# Maximum time, in seconds, to wait for one ASI:One model request.
ASI1_REQUEST_TIMEOUT=60
RELEASE_GUARDIAN_LLM_PROVIDER=asi1
# A 60-point signal completes a focused ASI:One plan in one review pass by default.
# Raise this to request a slower second Actor-Critic refinement pass.
RELEASE_GUARDIAN_MIN_SCORE=60
CODEBRAIN_KNOWLEDGE_ENABLED=false

# The only optional action is a trusted local Git repository's pytest suite.
# Chat can approve it but can never supply the path or command. Set this to the
# absolute path of a repository you trust to execute locally.
RELEASE_GUARDIAN_ALLOWED_TARGETS=configured_repository
RELEASE_GUARDIAN_REPO_PATH=/absolute/path/to/your/release-repository
RELEASE_GUARDIAN_REPO_TEST_COMMAND="python -m pytest -q"
RELEASE_GUARDIAN_REPO_TEST_TIMEOUT=120

# Optional: only enable after the agent is deployed at a public HTTPS endpoint.
# Never use the Agentverse Inspector URL or a localhost URL here. This API key
# is separate from ASI1_API_KEY and the seed must remain FETCH_AGENT_SEED.
AGENTVERSE_V2_REGISTRATION_ENABLED=false
AGENTVERSE_API_KEY=
AGENTVERSE_PUBLIC_ENDPOINT=https://your-public-domain.example/submit

# Optional existing web-platform providers. Configure only the provider you select.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
